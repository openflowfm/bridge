{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "moduleDetection": "auto",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "../core/src/**/*.ts",
    "../protocol/**/*.ts",
    "../protocol/**/*.d.ts"
  ]
}
